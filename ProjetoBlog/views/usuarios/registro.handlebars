<div class="form-container mx-auto">
{{#each erros}}
	<div class="alert alert-danger">{{texto}}</div>
{{/each}}

	<div class="card card-auth">
		<div class="topo p-4">
			<h2 class="mb-1">Criar Conta</h2>
			<p class="mb-0">Preencha os dados abaixo.</p>
		</div>
		<div class="card-body p-4">
			<form action="/usuarios/registro" method="POST">
				<div class="mb-3">
					<label for="nome" class="form-label">Nome</label>
					<input type="text" id="nome" name="nome" placeholder="Nome" class="form-control" required>
				</div>
				<div class="mb-3">
					<label for="email" class="form-label">E-mail</label>
					<input type="email" id="email" name="email" placeholder="seu@email.com" class="form-control" required>
				</div>
				<div class="mb-3">
					<label for="senha" class="form-label">Senha</label>
					<input type="password" id="senha" name="senha" placeholder="Mínimo de 4 caracteres" class="form-control" required>
				</div>
				<div class="mb-4">
					<label for="senha2" class="form-label">Repetir Senha</label>
					<input type="password" id="senha2" name="senha2" placeholder="Repita a senha" class="form-control" required>
				</div>
				<button class="btn btn-primary w-100" type="submit">Criar Conta</button>
			</form>
			<p class="text-center mt-3 mb-0"><small>Já tem conta? <a href="/usuarios/login">Entrar</a></small></p>
		</div>
	</div>
</div>

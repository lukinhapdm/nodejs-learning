<h2 class="titulo-secao mb-2">Resultados da busca</h2>
<p class="text-body-secondary mb-4">{{postagens.length}} resultado(s) para "<strong>{{termo}}</strong>"</p>

<div class="row g-4">
{{#each postagens}}
	<div class="col-md-6 col-lg-4">
		{{>_postcard}}
	</div>
{{else}}
	<div class="col-12">
		<div class="card">
			<div class="card-body text-center py-5">
				<p class="text-body-secondary">Nenhuma postagem encontrada.</p>
				<a href="/" class="btn btn-primary">Ver todas as postagens</a>
			</div>
		</div>
	</div>
{{/each}}
</div>

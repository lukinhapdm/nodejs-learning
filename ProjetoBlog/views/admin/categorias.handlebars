<div class="d-flex justify-content-between align-items-center mb-4">
	<h2 class="titulo-secao mb-0">Categorias</h2>
	<a href="/admin/categorias/add" class="btn btn-primary">Nova Categoria</a>
</div>

<div class="card">
	<div class="table-responsive">
		<table class="table table-hover align-middle mb-0">
			<thead>
				<tr>
					<th>Nome</th>
					<th>Slug</th>
					<th>Data</th>
					<th class="text-end">Ações</th>
				</tr>
			</thead>
			<tbody>
			{{#each categorias}}
				<tr>
					<td><strong>{{nome}}</strong></td>
					<td><code>{{slug}}</code></td>
					<td>{{formatDate date}}</td>
					<td class="text-end text-nowrap">
						<a href="/admin/categorias/edit/{{_id}}" class="btn btn-sm btn-outline-primary">Editar</a>
						<form action="/admin/categorias/delete" method="POST" class="d-inline" data-confirmar="Deseja deletar a categoria &quot;{{nome}}&quot;?">
							<input type="hidden" name="id" value="{{_id}}">
							<button type="submit" class="btn btn-sm btn-outline-danger">Deletar</button>
						</form>
					</td>
				</tr>
			{{else}}
				<tr><td colspan="4" class="text-center text-body-secondary py-4">Nenhuma categoria registrada!</td></tr>
			{{/each}}
			</tbody>
		</table>
	</div>
</div>

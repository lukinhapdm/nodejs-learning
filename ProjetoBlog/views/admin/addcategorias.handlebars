<a href="/admin/categorias" class="btn btn-link px-0 mb-3">&larr; Voltar</a>
<h2 class="titulo-secao">Nova Categoria</h2>

{{#each erros}}
	<div class="alert alert-danger">{{texto}}</div>
{{/each}}

<div class="card">
	<div class="card-body p-4">
		<form action="/admin/categorias/new" method="POST">
			<div class="mb-3">
				<label for="nome" class="form-label">Nome</label>
				<input type="text" id="nome" name="nome" data-slug-origem="slug" placeholder="Nome da categoria" class="form-control">
			</div>
			<div class="mb-3">
				<label for="slug" class="form-label">Slug <small class="text-body-secondary">(gerado automaticamente, usado na URL)</small></label>
				<input type="text" id="slug" name="slug" placeholder="slug-da-categoria" class="form-control">
			</div>
			<button type="submit" class="btn btn-primary">Criar Categoria</button>
		</form>
	</div>
</div>

<h2 class="titulo-secao mb-2">Painel Admin</h2>
<p class="text-body-secondary mb-4">Resumo do conteúdo do blog.</p>

{{!-- Totais --}}
<div class="row g-4 mb-4">
	<div class="col-md-4">
		<div class="card stat-card stat-violeta h-100">
			<div class="card-body">
				<p class="mb-1">Postagens</p>
				<p class="display-6 mb-3">{{totalPostagens}}</p>
				<a href="/admin/postagens" class="btn btn-sm btn-light fw-semibold">Gerenciar</a>
				<a href="/admin/postagens/add" class="btn btn-sm btn-outline-light">Nova</a>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card stat-card stat-verde h-100">
			<div class="card-body">
				<p class="mb-1">Categorias</p>
				<p class="display-6 mb-3">{{totalCategorias}}</p>
				<a href="/admin/categorias" class="btn btn-sm btn-light fw-semibold">Gerenciar</a>
				<a href="/admin/categorias/add" class="btn btn-sm btn-outline-light">Nova</a>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card stat-card stat-laranja h-100">
			<div class="card-body">
				<p class="mb-1">Usuários</p>
				<p class="display-6 mb-3">{{totalUsuarios}}</p>
				<a href="/admin/usuarios" class="btn btn-sm btn-light fw-semibold">Gerenciar</a>
			</div>
		</div>
	</div>
</div>

{{!-- Últimas postagens --}}
<div class="card">
	<div class="card-body">
		<h5 class="card-title titulo-secao">Últimas postagens</h5>
		<div class="list-group list-group-flush">
		{{#each ultimas}}
			<a href="/admin/postagens/edit/{{_id}}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0">
				<span>{{titulo}} <span class="badge badge-cat ms-2 {{corCategoria categoria.nome}}">{{categoria.nome}}</span></span>
				<small class="text-body-secondary">{{formatDate date}}</small>
			</a>
		{{else}}
			<p class="text-body-secondary mb-0">Nenhuma postagem registrada!</p>
		{{/each}}
		</div>
	</div>
</div>

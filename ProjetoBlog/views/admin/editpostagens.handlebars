<a href="/admin/postagens" class="btn btn-link px-0 mb-3">&larr; Voltar</a>
<h2 class="titulo-secao">Editar Postagem</h2>

{{#each erros}}
	<div class="alert alert-danger">{{texto}}</div>
{{/each}}

<div class="card">
	<div class="card-body p-4">
		<form action="/admin/postagens/edit" method="POST">
			<input type="hidden" name="id" value="{{postagem._id}}">
			<div class="mb-3">
				<label for="titulo" class="form-label">Título</label>
				<input type="text" id="titulo" name="titulo" data-slug-origem="slug" placeholder="Título da postagem" class="form-control" value="{{postagem.titulo}}" required>
			</div>
			<div class="mb-3">
				<label for="slug" class="form-label">Slug <small class="text-body-secondary">(gerado automaticamente, usado na URL)</small></label>
				<input type="text" id="slug" name="slug" placeholder="slug-da-postagem" class="form-control" value="{{postagem.slug}}" required>
			</div>
			<div class="mb-3">
				<label for="descricao" class="form-label">Descrição</label>
				<input type="text" id="descricao" name="descricao" placeholder="Breve descrição da postagem" class="form-control" value="{{postagem.descricao}}" required>
			</div>
			<div class="mb-3">
				<label for="conteudo" class="form-label">Conteúdo</label>
				<textarea id="conteudo" name="conteudo" rows="8" class="form-control" required>{{postagem.conteudo}}</textarea>
			</div>
			<div class="mb-4">
				<label for="categoria" class="form-label">Categoria</label>
				<select id="categoria" name="categoria" class="form-select">
					{{#each categorias}}
						<option value="{{_id}}"{{#if (eq _id ../postagem.categoria)}} selected{{/if}}>{{nome}}</option>
					{{else}}
						<option value="0">Nenhuma categoria registrada!</option>
					{{/each}}
				</select>
			</div>
			<button type="submit" class="btn btn-primary">Salvar Alterações</button>
		</form>
	</div>
</div>
